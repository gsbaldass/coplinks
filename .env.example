# Referência de variáveis de ambiente para o projeto elo.
#
# IMPORTANTE: Não coloque segredos no Git. Configure estas variáveis:
#   - No Laragon: Apache VirtualHost com SetEnv, ou via .htaccess local
#   - Em produção: painel de variáveis do servidor/hospedagem
#
# O bootstrap.php NÃO carrega .env automaticamente.
# Renomeie este arquivo para .env e use um loader (ex: vlucas/phpdotenv) se preferir,
# ou configure as variáveis diretamente no servidor.

# URL do banco de dados.
# Laragon (MySQL local, usuário root sem senha):
DATABASE_URL=mysql://root:@localhost:3306/coplinks

# Origem pública do site (usada nas URLs de redirecionamento e cookies).
# Em desenvolvimento local com Laragon:
PUBLIC_ORIGIN=http://localhost

# E-mail(s) do(s) administrador(es). Separados por vírgula ou ponto-e-vírgula.
ADMIN_EMAILS=convencao.oestepaulista.links@gmail.com

# Senha de acesso ao painel administrativo.
# Para desenvolvimento: texto simples (ex: minha-senha-local)
# Para produção: hash bcrypt gerado por password_hash('sua-senha', PASSWORD_BCRYPT)
#   php -r "echo password_hash('sua-senha', PASSWORD_BCRYPT);"
ADMIN_PASSWORD=cop010108
